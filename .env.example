# Permanent Shopify domain. Do not use the public custom domain.
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# Recommended: Admin API access token from the SAME Shopify store.
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_replace_me

# Alternative for an organization-owned Dev Dashboard app installed in this store.
# The static Admin token is used first when both methods are configured.
# SHOPIFY_CLIENT_ID=replace_me
# SHOPIFY_CLIENT_SECRET=replace_me

SHOPIFY_API_VERSION=2026-01
DEFAULT_CURRENCY_CODE=CAD
ALLOW_CUSTOM_LINE_FALLBACK=true

# Comma-separated storefront origins, without trailing slashes.
ALLOWED_ORIGINS_CSV=https://islandmurphybeds.com,https://www.islandmurphybeds.com,https://your-store-name.myshopify.com
